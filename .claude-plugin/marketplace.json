{
  "name": "supero",
  "description": "Supero plugins for Claude Code. The supero plugin now lives in supero-platform/supero-mcp; this marketplace installs it from there.",
  "owner": {
    "name": "Supero",
    "email": "info@supero.dev",
    "url": "https://supero.dev"
  },
  "plugins": [
    {
      "name": "supero",
      "source": {
        "source": "git-subdir",
        "url": "supero-platform/supero-mcp",
        "path": "plugins/supero",
        "ref": "main"
      },
      "description": "Multi-tenant backend your coding agent configures over MCP: auth, RBAC, data, workflows, deploy.",
      "category": "development",
      "tags": [
        "mcp",
        "app-builder",
        "backend",
        "deploy",
        "multi-tenant"
      ],
      "relevance": {
        "topic": "Supero",
        "signals": {
          "hosts": [
            "mcp.supero.dev",
            "api.supero.dev",
            "app.supero.dev"
          ],
          "manifestDeps": [
            {
              "file": "[/\\\\]requirements\\.txt$",
              "pattern": "(^|\\n)supero(?![-\\w.])"
            }
          ]
        }
      }
    }
  ]
}
